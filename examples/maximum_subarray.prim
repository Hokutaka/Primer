// 連続する区間を選び、合計が一番大きくなる区間の合計を求めます。
// 例えば4, -1, 2, 1を選ぶと合計は6です。
fn larger(left: i32, right: i32) -> i32 {
    if left > right { return left; }
    return right;
}

changes: [i32; 9] = [-2, 1, -3, 4, -1, 2, 1, -5, 4];
mut ending_here: i32 = changes[0];
mut best: i32 = ending_here;
mut index: u32 = 1;
while index < 9 {
    // 添字にはi64が必要なので、型を変える場所を明示します。
    change: i32 = changes[i64(index)];
    ending_here = larger(change, ending_here + change);
    best = larger(best, ending_here);
    print(ending_here);
    index = index + 1;
}

// 各位置で終わる区間の最大合計を表示した後、全体の答え6を表示します。
print(best);
