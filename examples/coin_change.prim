// 1円、3円、4円の硬貨で、6円を最少何枚で支払えるでしょうか。
// 大きい硬貨から選ぶと4+1+1の3枚ですが、3+3なら2枚です。
coins: [i64; 3] = [1, 3, 4];

// best[金額]に、その金額を作るための最少枚数を記録します。
// 0円は0枚。それ以外は、答えより必ず大きい7で始めます。
mut best: [i64; 7] = [0, 7, 7, 7, 7, 7, 7];
mut last_coin: [i64; 7] = [0, 0, 0, 0, 0, 0, 0];

for (mut amount: i64 = 1; amount <= 6; amount = amount + 1) {
    for (mut index: i64 = 0; index < 3; index = index + 1) {
        coin: i64 = coins[index];
        if coin <= amount {
            // 硬貨を1枚足す前の金額は、すでに計算済みです。
            candidate: i64 = best[amount - coin] + 1;
            if candidate < best[amount] {
                best[amount] = candidate;
                last_coin[amount] = coin;
            }
        }
    }
    // 1円から6円までの最少枚数: 1, 2, 1, 1, 2, 2。
    print(best[amount]);
}

// 記録をたどると、使う硬貨も分かります。出力は3, 3です。
mut remaining: i64 = 6;
while remaining > 0 {
    coin: i64 = last_coin[remaining];
    print(coin);
    remaining = remaining - coin;
}
