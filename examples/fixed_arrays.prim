values: [i64; 6] = [4, 8, 15, 16, 23, 42];

mut total: i64 = 0;
mut found_at: i64 = -1;

for (mut index: i64 = 0; index < 6; index = index + 1) {
    total = total + values[index];
}

for (mut index: i64 = 0; index < 6; index = index + 1) {
    if values[index] == 23 {
        found_at = index;
        break;
    }
}

print(total);
print(found_at);
