// 1を1万分の1にする操作を6回繰り返します。
// とても小さくなっても、ゼロでなければ指数表記で値を表示します。
mut value: f64 = 1.0;
for (mut step: i64 = 0; step < 6; step = step + 1) {
    value = value * 0.0001;
    print(value);
}
print(value != 0.0);

// 小さい値は存在しますが、1に足すとf64の精度では違いを表せません。
// 表示で消える問題と、計算で丸められる問題は別です。
print(1.0 + value == 1.0);
