data $fmt_i64 = { b "%lld", b 10, b 0 }
data $fmt_f32 = { b "%.9g", b 10, b 0 }
data $fmt_f64 = { b "%.17g", b 10, b 0 }

function l $primer_i64_add(l %left, l %right) {
@start
  %result =l add %left, %right
  %left_changed =l xor %result, %left
  %right_changed =l xor %result, %right
  %sign_changed =l and %left_changed, %right_changed
  %overflow =w csltl %sign_changed, 0
  jnz %overflow, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  ret %result
}

export function w $main() {
@start
  %slot_value =l alloc8 8
  %slot_sum =l alloc8 8
  storel 0, %slot_value
  storel 0, %slot_sum
  jmp @block0
@block0 # while_condition
  %tmp0 =l loadl %slot_value
  %tmp1 =w csltl %tmp0, 10
  jnz %tmp1, @block1, @block2
@block1 # while_body
  %tmp2 =l loadl %slot_value
  %tmp3 =l call $primer_i64_add(l %tmp2, l 1)
  storel %tmp3, %slot_value
  %tmp4 =l loadl %slot_value
  %tmp5 =w csltl %tmp4, 3
  jnz %tmp5, @block3, @block4
@block3 # if_then
  jmp @block0
@block4 # if_else
  jmp @block5
@block5 # if_end
  %tmp6 =l loadl %slot_value
  %tmp7 =w csgtl %tmp6, 5
  jnz %tmp7, @block6, @block7
@block6 # if_then
  jmp @block2
@block7 # if_else
  jmp @block8
@block8 # if_end
  %tmp8 =l loadl %slot_sum
  %tmp9 =l loadl %slot_value
  %tmp10 =l call $primer_i64_add(l %tmp8, l %tmp9)
  storel %tmp10, %slot_sum
  jmp @block0
@block2 # while_end
  %tmp11 =l loadl %slot_sum
  %tmp12 =w call $printf(l $fmt_i64, ..., l %tmp11)
  %tmp13 =l loadl %slot_value
  %tmp14 =w call $printf(l $fmt_i64, ..., l %tmp13)
  ret 0
}
