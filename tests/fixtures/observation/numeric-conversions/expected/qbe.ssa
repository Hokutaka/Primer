function l $primer_convert_f32_i16(s %value) {
@start
  %number =d exts %value
  %nan =w cuod %number, %number
  %below =w cltd %number, d_-32768
  %above =w cged %number, d_32768
  %outside =w or %below, %above
  %bits =l cast %number
  %negative_zero =w ceql %bits, -9223372036854775808
  %special =w or %nan, %negative_zero
  %bad =w or %outside, %special
  jnz %bad, @trap, @convert
@convert
  %result =l dtosi %number
  %back =d sltof %result
  %changed =w cned %back, %number
  jnz %changed, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  ret %result
}

