function d $primer_fn_measure_0(l %arg0) {
@start
  %slot_value =l alloc8 8
  storel %arg0, %slot_value
  %tmp0 =l loadl %slot_value
  %tmp1 =d call $primer_convert_i16_f64(l %tmp0)
  %tmp2 =d call $primer_convert_i64_f64(l 2)
  %tmp3 =d div %tmp1, %tmp2
  ret %tmp3
}

export function w $main() {
@start
  %slot_count =l alloc8 8
  %slot_wide =l alloc8 8
  %slot_narrow =l alloc8 8
  storel 42, %slot_count
  %tmp0 =l loadl %slot_count
  %tmp1 =d call $primer_convert_u32_f64(l %tmp0)
  stored %tmp1, %slot_wide
  %tmp2 =d loadd %slot_wide
  %tmp3 =s call $primer_convert_f64_f32(d %tmp2)
  stores %tmp3, %slot_narrow
  %tmp4 =s loads %slot_narrow
  %tmp5 =l call $primer_convert_f32_i16(s %tmp4)
  %tmp6 =w call $printf(l $fmt_i64, ..., l %tmp5)
  %tmp7 =d loadd %slot_wide
  %tmp8 =l call $primer_convert_f64_i64(d %tmp7)
  %tmp9 =w call $printf(l $fmt_i64, ..., l %tmp8)
  %tmp10 =s loads %slot_narrow
  %tmp11 =d call $primer_convert_f32_f64(s %tmp10)
  %tmp12 =w call $printf(l $fmt_f64, ..., d %tmp11)
  %tmp13 =l loadl %slot_count
  %tmp14 =s call $primer_convert_u32_f32(l %tmp13)
  %tmp15 =d exts %tmp14
  %tmp16 =w call $printf(l $fmt_f32, ..., d %tmp15)
  %tmp17 =d call $primer_fn_measure_0(l 3)
  %tmp18 =w call $printf(l $fmt_f64, ..., d %tmp17)
  %tmp19 =d neg d_0.0
  %tmp20 =s call $primer_convert_f64_f32(d %tmp19)
  %tmp21 =d exts %tmp20
  %tmp22 =w call $printf(l $fmt_f32, ..., d %tmp21)
  ret 0
}
