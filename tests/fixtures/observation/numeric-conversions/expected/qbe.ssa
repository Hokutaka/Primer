data $fmt_i64 = { b "%lld", b 10, b 0 }
data $fmt_f32 = { b "%.9g", b 10, b 0 }
data $fmt_f64 = { b "%.17g", b 10, b 0 }

function d $primer_convert_i16_f64(l %value) {
@start
  %result =d sltof %value
  %below =w cltd %result, d_-9223372036854775808
  %above =w cged %result, d_9223372036854775808
  %outside =w or %below, %above
  jnz %outside, @trap, @convert
@convert
  %back =l dtosi %result
  %changed =w cnel %back, %value
  jnz %changed, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  ret %result
}

function s $primer_convert_u32_f32(l %value) {
@start
  %result =s sltof %value
  %number =d exts %result
  %below =w cltd %number, d_-9223372036854775808
  %above =w cged %number, d_9223372036854775808
  %outside =w or %below, %above
  jnz %outside, @trap, @convert
@convert
  %back =l dtosi %number
  %changed =w cnel %back, %value
