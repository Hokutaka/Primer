data $fmt_i64 = { b "%lld", b 10, b 0 }
data $fmt_f32 = { b "%.9g", b 10, b 0 }
data $fmt_f64 = { b "%.17g", b 10, b 0 }

function l $primer_i64_add(l %left, l %right) {
@start
  %result =l add %left, %right
  %left_changed =l xor %result, %left
  %right_changed =l xor %result, %right
  %sign_changed =l and %left_changed, %right_changed
  %overflow =w csltl %sign_changed, 0
  jnz %overflow, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  ret %result
}

function l $primer_i64_sub(l %left, l %right) {
@start
  %result =l sub %left, %right
  %operands_differ =l xor %left, %right
  %result_changed =l xor %left, %result
  %sign_changed =l and %operands_differ, %result_changed
  %overflow =w csltl %sign_changed, 0
  jnz %overflow, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  ret %result
}

function l $primer_i64_mul(l %left, l %right) {
@start
  %left_zero =w ceql %left, 0
  jnz %left_zero, @zero, @special
@special
  %left_negative_one =w ceql %left, -1
  %right_min =w ceql %right, -9223372036854775808
  %first_special =w and %left_negative_one, %right_min
  %right_negative_one =w ceql %right, -1
  %left_min =w ceql %left, -9223372036854775808
  %second_special =w and %right_negative_one, %left_min
  %special_overflow =w or %first_special, %second_special
  jnz %special_overflow, @trap, @multiply
@multiply
  %result =l mul %left, %right
  %quotient =l div %result, %left
  %overflow =w cnel %quotient, %right
  jnz %overflow, @trap, @ok
@zero
  ret 0
@trap
  call $abort()
  hlt
@ok
  ret %result
}

function l $primer_i64_div(l %left, l %right) {
@start
  %is_zero =w ceql %right, 0
  %is_min =w ceql %left, -9223372036854775808
  %is_negative_one =w ceql %right, -1
  %overflows =w and %is_min, %is_negative_one
  %invalid =w or %is_zero, %overflows
  jnz %invalid, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  %result =l div %left, %right
  ret %result
}

function l $primer_i64_neg(l %value) {
@start
  %overflow =w ceql %value, -9223372036854775808
  jnz %overflow, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  %result =l neg %value
  ret %result
}

export function w $main() {
@start
  %slot_value =l alloc8 8
  storel 8, %slot_value
  %tmp0 =l loadl %slot_value
  %tmp1 =l call $primer_i64_add(l %tmp0, l 1)
  %tmp2 =w call $printf(l $fmt_i64, ..., l %tmp1)
  %tmp3 =l loadl %slot_value
  %tmp4 =l call $primer_i64_sub(l %tmp3, l 1)
  %tmp5 =w call $printf(l $fmt_i64, ..., l %tmp4)
  %tmp6 =l loadl %slot_value
  %tmp7 =l call $primer_i64_mul(l %tmp6, l 2)
  %tmp8 =w call $printf(l $fmt_i64, ..., l %tmp7)
  %tmp9 =l loadl %slot_value
  %tmp10 =l call $primer_i64_div(l %tmp9, l 2)
  %tmp11 =w call $printf(l $fmt_i64, ..., l %tmp10)
  %tmp12 =l loadl %slot_value
  %tmp13 =l call $primer_i64_neg(l %tmp12)
  %tmp14 =w call $printf(l $fmt_i64, ..., l %tmp13)
  ret 0
}
