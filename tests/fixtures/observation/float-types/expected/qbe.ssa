data $fmt_i64 = { b "%lld", b 10, b 0 }
data $fmt_f32 = { b "%.9g", b 10, b 0 }
data $fmt_f64 = { b "%.17g", b 10, b 0 }

export function w $main() {
@start
  %tmp0 =s add s_0.1, s_0.2
  %primer_single =s copy %tmp0
  %tmp1 =d add d_0.1, d_0.2
  %primer_double =d copy %tmp1
  %tmp2 =d add d_0.1, d_0.2
  %primer_inferred =d copy %tmp2
  %tmp3 =s add s_0.1, s_0.2
  %primer_suffixed =s copy %tmp3
  %tmp4 =d exts %primer_single
  %tmp5 =w call $printf(l $fmt_f32, ..., d %tmp4)
  %tmp6 =w call $printf(l $fmt_f64, ..., d %primer_double)
  %tmp7 =w call $printf(l $fmt_f64, ..., d %primer_inferred)
  %tmp8 =d exts %primer_suffixed
  %tmp9 =w call $printf(l $fmt_f32, ..., d %tmp8)
  ret 0
}
