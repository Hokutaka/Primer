; Primer bytecode v0.1

.slot 0 mut count i64
.slot 1 mut sum i64
.slot 2 marker bool

0000  push.i64 0
0001  store 0       ; count
0002  push.i64 0
0003  store 1       ; sum
0004  load 0        ; count
0005  push.i64 4
0006  lt.i64
0007  jump-if-false 0025
0008  load 1        ; sum
0009  load 0        ; count
0010  add.i64
0011  assign 1      ; sum
0012  load 0        ; count
0013  push.i64 2
0014  eq.i64
0015  jump-if-false 0020
0016  push.bool true
0017  store 2       ; marker
0018  load 2        ; marker
0019  print.bool
0020  load 0        ; count
0021  push.i64 1
0022  add.i64
0023  assign 0      ; count
0024  jump 0004
0025  load 1        ; sum
0026  print.i64
0027  halt
