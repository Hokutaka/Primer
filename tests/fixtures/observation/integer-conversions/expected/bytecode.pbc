; Primer bytecode v0.1

.function 0 value() -> i64
0000  push.i64 7
0001  print.i64
0002  push.i64 42
0003  return.value
.end

.slot 0 compact i64
.slot 1 explicit i64

0000  call 0 0  ; value
0001  convert.checked i64 -> i64
0002  store 0       ; compact
0003  load 0        ; compact
0004  convert.checked i64 -> i64
0005  store 1       ; explicit
0006  load 1        ; explicit
0007  print.i64
0008  halt
