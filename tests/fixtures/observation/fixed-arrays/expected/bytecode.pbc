; Primer bytecode v0.1

.slot 0 mut values [i64; 3]
.slot 1 copy [i64; 3]

0000  push.i64 2
0001  push.i64 4
0002  push.i64 6
0003  array.new i64 3
0004  store 0       ; values
0005  load 0        ; values
0006  store 1       ; copy
0007  push.i64 1
0008  push.i64 3
0009  push.i64 5
0010  array.new i64 3
0011  assign 0      ; values
0012  load 1        ; copy
0013  push.i64 2
0014  array.get i64 3
0015  print.i64
0016  load 0        ; values
0017  push.i64 1
0018  array.get i64 3
0019  print.i64
0020  halt
