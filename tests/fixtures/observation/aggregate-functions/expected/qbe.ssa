data $fmt_i64 = { b "%lld", b 10, b 0 }
data $fmt_f32 = { b "%.9g", b 10, b 0 }
data $fmt_f64 = { b "%.17g", b 10, b 0 }

function l $primer_i64_add(l %left, l %right) {
@start
  %result =l add %left, %right
  %left_changed =l xor %result, %left
  %right_changed =l xor %result, %right
  %sign_changed =l and %left_changed, %right_changed
  %overflow =w csltl %sign_changed, 0
  jnz %overflow, @trap, @ok
@trap
  call $abort()
  hlt
@ok
  ret %result
}

function $primer_fn_move_x_0(l %result, l %arg0, l %arg1) {
@start
  %slot_point =l alloc8 16
  %slot_amount =l alloc8 8
  %slot_aggregate_tmp0 =l alloc8 16
  blit %arg0, %slot_point, 16
  storel %arg1, %slot_amount
  %tmp0 =l loadl %slot_point
  %tmp1 =l loadl %slot_amount
  %tmp2 =l call $primer_i64_add(l %tmp0, l %tmp1)
  storel %tmp2, %slot_aggregate_tmp0
  %tmp3 =l add %slot_point, 8
  %tmp4 =l loadl %tmp3
  %tmp5 =l add %slot_aggregate_tmp0, 8
  storel %tmp4, %tmp5
  blit %slot_aggregate_tmp0, %result, 16
  ret
}

function $primer_fn_move_twice_1(l %result, l %arg0, l %arg1) {
@start
  %slot_point =l alloc8 16
  %slot_amount =l alloc8 8
  %slot_aggregate_tmp0 =l alloc8 16
  %slot_aggregate_tmp1 =l alloc8 16
  blit %arg0, %slot_point, 16
  storel %arg1, %slot_amount
  %tmp0 =l loadl %slot_amount
  call $primer_fn_move_x_0(l %slot_aggregate_tmp1, l %slot_point, l %tmp0)
  %tmp1 =l loadl %slot_amount
  call $primer_fn_move_x_0(l %slot_aggregate_tmp0, l %slot_aggregate_tmp1, l %tmp1)
  blit %slot_aggregate_tmp0, %result, 16
  ret
}

function $primer_fn_first_row_2(l %result, l %arg0) {
@start
  %slot_matrix =l alloc8 32
  blit %arg0, %slot_matrix, 32
  %tmp0 =w csltl 0, 0
  jnz %tmp0, @block2, @block0
@block0 # array_index_non_negative
  %tmp1 =w csgel 0, 2
  jnz %tmp1, @block2, @block1
@block2 # array_index_out_of_bounds
  call $abort()
  hlt
@block1 # array_index_in_bounds
  %tmp2 =l mul 0, 16
  %tmp3 =l add %slot_matrix, %tmp2
  blit %tmp3, %result, 16
  ret
}

function $primer_fn_duplicate_3(l %result, l %arg0) {
@start
  %slot_row =l alloc8 16
  %slot_aggregate_tmp0 =l alloc8 32
  blit %arg0, %slot_row, 16
  blit %slot_row, %slot_aggregate_tmp0, 16
  %tmp0 =l add %slot_aggregate_tmp0, 16
  blit %slot_row, %tmp0, 16
  blit %slot_aggregate_tmp0, %result, 32
  ret
}

function $primer_fn_duplicate_first_row_4(l %result, l %arg0) {
@start
  %slot_matrix =l alloc8 32
  %slot_aggregate_tmp0 =l alloc8 32
  %slot_aggregate_tmp1 =l alloc8 16
  blit %arg0, %slot_matrix, 32
  call $primer_fn_first_row_2(l %slot_aggregate_tmp1, l %slot_matrix)
  call $primer_fn_duplicate_3(l %slot_aggregate_tmp0, l %slot_aggregate_tmp1)
  blit %slot_aggregate_tmp0, %result, 32
  ret
}

