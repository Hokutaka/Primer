data $fmt_i64 = { b "%lld", b 10, b 0 }
data $fmt_f32 = { b "%.9g", b 10, b 0 }
data $fmt_f64 = { b "%.17g", b 10, b 0 }

export function w $main() {
@start
  %slot_matrix =l alloc8 48
  %slot_copy =l alloc8 48
  %slot_aggregate_tmp0 =l alloc8 48
  %slot_aggregate_tmp1 =l alloc8 24
  %slot_aggregate_tmp2 =l alloc8 24
  %slot_aggregate_tmp3 =l alloc8 48
  %slot_aggregate_tmp4 =l alloc8 24
  %slot_aggregate_tmp5 =l alloc8 24
  storel 1, %slot_aggregate_tmp1
  %tmp0 =l add %slot_aggregate_tmp1, 8
  storel 2, %tmp0
  %tmp1 =l add %slot_aggregate_tmp1, 16
  storel 3, %tmp1
  blit %slot_aggregate_tmp1, %slot_aggregate_tmp0, 24
  storel 4, %slot_aggregate_tmp2
  %tmp2 =l add %slot_aggregate_tmp2, 8
  storel 5, %tmp2
  %tmp3 =l add %slot_aggregate_tmp2, 16
  storel 6, %tmp3
  %tmp4 =l add %slot_aggregate_tmp0, 24
  blit %slot_aggregate_tmp2, %tmp4, 24
  blit %slot_aggregate_tmp0, %slot_matrix, 48
  blit %slot_matrix, %slot_copy, 48
  storel 7, %slot_aggregate_tmp4
  %tmp5 =l add %slot_aggregate_tmp4, 8
  storel 8, %tmp5
  %tmp6 =l add %slot_aggregate_tmp4, 16
  storel 9, %tmp6
  blit %slot_aggregate_tmp4, %slot_aggregate_tmp3, 24
  storel 10, %slot_aggregate_tmp5
  %tmp7 =l add %slot_aggregate_tmp5, 8
  storel 11, %tmp7
  %tmp8 =l add %slot_aggregate_tmp5, 16
  storel 12, %tmp8
  %tmp9 =l add %slot_aggregate_tmp3, 24
  blit %slot_aggregate_tmp5, %tmp9, 24
  blit %slot_aggregate_tmp3, %slot_matrix, 48
  %tmp10 =w csltl 1, 0
  jnz %tmp10, @block2, @block0
@block0 # array_index_non_negative
  %tmp11 =w csgel 1, 2
  jnz %tmp11, @block2, @block1
@block2 # array_index_out_of_bounds
  call $abort()
  hlt
@block1 # array_index_in_bounds
  %tmp12 =l mul 1, 24
  %tmp13 =l add %slot_copy, %tmp12
  %tmp14 =w csltl 2, 0
  jnz %tmp14, @block5, @block3
@block3 # array_index_non_negative
  %tmp15 =w csgel 2, 3
  jnz %tmp15, @block5, @block4
@block5 # array_index_out_of_bounds
  call $abort()
  hlt
@block4 # array_index_in_bounds
  %tmp16 =l mul 2, 8
  %tmp17 =l add %tmp13, %tmp16
  %tmp18 =l loadl %tmp17
  %tmp19 =w call $printf(l $fmt_i64, ..., l %tmp18)
  %tmp20 =w csltl 0, 0
  jnz %tmp20, @block8, @block6
@block6 # array_index_non_negative
  %tmp21 =w csgel 0, 2
  jnz %tmp21, @block8, @block7
@block8 # array_index_out_of_bounds
  call $abort()
  hlt
@block7 # array_index_in_bounds
  %tmp22 =l mul 0, 24
  %tmp23 =l add %slot_matrix, %tmp22
  %tmp24 =w csltl 1, 0
  jnz %tmp24, @block11, @block9
@block9 # array_index_non_negative
  %tmp25 =w csgel 1, 3
  jnz %tmp25, @block11, @block10
@block11 # array_index_out_of_bounds
  call $abort()
  hlt
@block10 # array_index_in_bounds
  %tmp26 =l mul 1, 8
  %tmp27 =l add %tmp23, %tmp26
  %tmp28 =l loadl %tmp27
  %tmp29 =w call $printf(l $fmt_i64, ..., l %tmp28)
  ret 0
}
