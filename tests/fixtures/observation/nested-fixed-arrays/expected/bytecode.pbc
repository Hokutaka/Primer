; Primer bytecode v0.1

.slot 0 mut matrix [[i64; 3]; 2]
.slot 1 copy [[i64; 3]; 2]

0000  push.i64 1
0001  push.i64 2
0002  push.i64 3
0003  array.new i64 3
0004  push.i64 4
0005  push.i64 5
0006  push.i64 6
0007  array.new i64 3
0008  array.new [i64; 3] 2
0009  store 0       ; matrix
0010  load 0        ; matrix
0011  store 1       ; copy
0012  push.i64 7
0013  push.i64 8
0014  push.i64 9
0015  array.new i64 3
0016  push.i64 10
0017  push.i64 11
0018  push.i64 12
0019  array.new i64 3
0020  array.new [i64; 3] 2
0021  assign 0      ; matrix
0022  load 1        ; copy
0023  push.i64 1
0024  array.get [i64; 3] 2
0025  push.i64 2
0026  array.get i64 3
0027  print.i64
0028  load 0        ; matrix
0029  push.i64 0
0030  array.get [i64; 3] 2
0031  push.i64 1
0032  array.get i64 3
0033  print.i64
0034  halt
